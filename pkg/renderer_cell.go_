package pkg

import (
	"image/color"
	"sync"

	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/canvas"
	"fyne.io/fyne/v2/container"
)

type CellRenderer struct {
	ctx         *RenderContext
	regionCells map[GridRegion]map[CellID]*CellCarcuss
	fontManager *FontManager
	//recycler    *Recycler
	recyclers map[GridRegion]*CellRecycler
}

type CellRecycler struct {
	mu    sync.Mutex
	items []*CellCarcuss
}

type CellCarcuss struct {
	CellContainer *fyne.Container
	Background    *canvas.Rectangle
	Content       fyne.CanvasObject
}

func NewRecycler() *CellRecycler {
	return &CellRecycler{
		mu:    sync.Mutex{},
		items: []*CellCarcuss{},
	}
}

func NewCellRenderer(ctx *RenderContext, fontMgr *FontManager) *CellRenderer {
	return &CellRenderer{
		ctx:         ctx,
		fontManager: fontMgr,
		regionCells: map[GridRegion]map[CellID]*CellCarcuss{
			RegionMain:        make(map[CellID]*CellCarcuss),
			RegionFixedCorner: make(map[CellID]*CellCarcuss),
			RegionFrozenRows:  make(map[CellID]*CellCarcuss),
			RegionFrozenCols:  make(map[CellID]*CellCarcuss),
		},
		recyclers: map[GridRegion]*CellRecycler{
			RegionMain:        NewRecycler(),
			RegionFixedCorner: NewRecycler(),
			RegionFrozenRows:  NewRecycler(),
			RegionFrozenCols:  NewRecycler(),
		},
	}
}

func (cyl *CellRecycler) Get() (*CellCarcuss, bool) {
	cyl.mu.Lock()
	if len(cyl.items) > 0 {

		last := len(cyl.items) - 1
		c := cyl.items[last]
		cyl.items[last] = nil
		cyl.items = cyl.items[:last]

		cyl.mu.Unlock()
		return c, true
	}
	cyl.mu.Unlock()

	bg := canvas.NewRectangle(color.White)
	text := canvas.NewText("", color.Black)
	text.TextSize = 11
	cellContainer := container.NewWithoutLayout(bg, text)

	return &CellCarcuss{
		CellContainer: cellContainer,
		Background:    bg,
		Content:       text,
	}, false

}
func (cyl *CellRecycler) Put(obj *CellCarcuss) {
	cyl.mu.Lock()
	cyl.items = append(cyl.items, obj)
	cyl.mu.Unlock()
}
func (c *CellCarcuss) SetTextValue(value string, font *FontStyle, fontMgr *FontManager) {
	if text, ok := c.Content.(*canvas.Text); ok {
		text.Text = value

		if font != nil {
			// Set font size
			if font.Size > 0 {
				text.TextSize = font.Size
			}

			// Set color
			if font.Color != nil {
				text.Color = font.Color
			} else {
				text.Color = color.Black
			}

			// Select appropriate font variant
			if fontMgr != nil {
				text.FontSource = fontMgr.SelectFont(font.Bold, font.Italic)
			}

			// Leave TextStyle empty when using real font variants
			text.TextStyle = fyne.TextStyle{}
		} else {
			text.TextSize = 11
			text.TextStyle = fyne.TextStyle{}
			text.Color = color.Black
			if fontMgr != nil {
				text.FontSource = fontMgr.Regular
			}
		}
	}
}

func (c *CellCarcuss) GetAsText() *canvas.Text {
	text, _ := c.Content.(*canvas.Text)
	return text
}

func (cr *CellRenderer) addCell(content *fyne.Container, cellMap map[CellID]*CellCarcuss, rowModIdx, colModIdx int, gridRegion GridRegion) *CellCarcuss {
	id := CellID{Row: rowModIdx, Col: colModIdx}
	if _, exists := cellMap[id]; exists {
		return nil
	}
	mm := cr.ctx.MergeManager

	if _, isMerged := mm.IsCellMerged(id); isMerged {
		return nil
	}

	if mm.IsVisibleMergeAnchor(id) {
		mergedCell := cr.addMergedCell(content, cellMap, id, gridRegion)
		return mergedCell
	}

	recycler := cr.recyclers[gridRegion]
	cell, recycled := recycler.Get()
	cr.configureCellCarcuss(cell, id, gridRegion)
	if !recycled {
		content.Add(cell.CellContainer)
	} else {
		cell.CellContainer.Show()
	}

	cellMap[id] = cell
	return cell
}

func (cr *CellRenderer) configureCellCarcuss(c *CellCarcuss, cellModID CellID, gridRegion GridRegion) {
	cm := cr.ctx.CoordManager
	mm := cr.ctx.MergeManager

	fm := cr.fontManager

	anchorCellModId, isMerged := mm.GetCellAnchor(cellModID)
	var cellData *CellData
	var exists bool

	if isMerged {
		cellData, exists = cr.ctx.Data.GridData[anchorCellModId]
	} else {
		cellData, exists = cr.ctx.Data.GridData[cellModID]
	}
	size := cm.GetCellSizeByModIdx(cellModID.Row, cellModID.Col)

	c.SetTextValue(cellData.Value, &cellData.Style.Font, fm)

	if exists && cellData != nil && cellData.Style != nil && cellData.Style.Fill.BgColor != nil {
		c.Background.FillColor = cellData.Style.Fill.BgColor
	} else {
		c.Background.FillColor = color.Transparent
	}

	if gridRegion == RegionMain {
		c.CellContainer.Move(cm.GetPixelPos(gridRegion, cellModID.Row, cellModID.Col))
	}

	if isMerged {
		if size, found := mm.GetMergeSize(anchorCellModId); found { // 1 method + loop
			c.CellContainer.Resize(size)
			c.Background.Resize(size)
		}
	} else {
		c.CellContainer.Resize(fyne.NewSize(size.Width, size.Height))
		c.Background.Resize(fyne.NewSize(size.Width, size.Height))
	}
}

func (cr *CellRenderer) addMergedCell(content *fyne.Container, cellMap map[CellID]*CellCarcuss, cellModID CellID, gridRegion GridRegion) *CellCarcuss {
	recycler := cr.recyclers[gridRegion]
	cell, recycled := recycler.Get()
	cr.configureCellCarcuss(cell, cellModID, gridRegion)
	if !recycled {
		content.Add(cell.CellContainer)
	} else {
		cell.CellContainer.Show()
	}

	cellMap[cellModID] = cell
	return cell
}

func (cr *CellRenderer) renderVisibleMerges(content *fyne.Container, cells map[CellID]*CellCarcuss, viewport Viewport, gridRegion GridRegion) {
	mm := cr.ctx.MergeManager

	for anchorCellModId := range mm.anchorToSize {
		isVisible := mm.IsMergeInViewport(anchorCellModId, viewport)
		_, isRendered := cells[anchorCellModId]

		if isVisible && !isRendered {
			cr.addMergedCell(content, cells, anchorCellModId, gridRegion)
		} else if !isVisible && isRendered {
			cr.removeCell(content, cells, anchorCellModId, gridRegion)
		}
	}
}

func (cr *CellRenderer) removeCell(content *fyne.Container, cellMap map[CellID]*CellCarcuss, cellModID CellID, gridRegion GridRegion) {

	if cell, exists := cellMap[cellModID]; exists {
		//ctx := cr.ctx
		mm := cr.ctx.MergeManager
		anchor, isMerged := mm.GetCellAnchor(cellModID)
		if isMerged && anchor == cellModID { // Is This Cell an anchor
			if mm.IsMergeInViewport(anchor, cr.ctx.Viewports[gridRegion]) {
				return // Don't remove - some part still visible
			}
		}

		cell.CellContainer.Hide()

		recycler := cr.recyclers[gridRegion]
		recycler.Put(cell)

		delete(cellMap, cellModID)
	}
}
